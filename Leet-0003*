'''Leet 3. Longest Substring Without Repeating Characters

Given a string s, find the length of the longest substring without duplicate characters.
'''

# Approach 1: Greedy moving window with variable length
# Time complexity O(n), beats 96.28%
# Space complexity O(sigma)

# Approach 2: Optimized with hash map (start pointer jumps)

class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        # Approach 2
        # return length in base case
        n = len(s)
        if n <= 1:
            return n
        # sliding window
        start = 0
        charMap = {s[0]: 0}
        length = 1
        for end in range(1,n):
            currChar = s[end]
            if currChar in charMap and charMap[currChar] >= start: 
                start = charMap[currChar] + 1
            charMap[currChar] = end
            length = max(length, end - start + 1)
        return length


