'''Leet 3345. Smallest Divisible Digit Product I

You are given two integers n and t. Return the smallest number greater than or equal to n such that the product of its digits is divisible by t.
'''

# Direct checking within 10 attempts.

class Solution:
    def smallestNumber(self, n: int, t: int) -> int:
        for i in range(10):
            smallest = n + i
            prod = 1
            while smallest > 0:
                prod *= smallest % 10
                smallest //= 10
            
            if prod % t == 0:
                return n + i
            
