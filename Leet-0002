'''Leet 2. Add Two Numbers

You are given two non-empty linked lists representing two non-negative integers. The digits are stored in reverse order, and each of their nodes contains a single digit. Add the two numbers and return the sum as a linked list.

You may assume the two numbers do not contain any leading zero, except the number 0 itself.
'''

# Direct adding digit by digit from the head (ones)
# For cleaner loop, a dummy head is added before the loop and discard at the end
# Time complexity O(max(m,n)), where m,n are number of nodes of l1,l2 reps.
# Space complexity (for algorithm, not answer): O(1). 


# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def addTwoNumbers(self, l1: Optional[ListNode], l2: Optional[ListNode]) -> Optional[ListNode]:
        dummyHead = ListNode(0)
        curr = dummyHead
        carry = 0
        while l1 != None or l2 != None or carry != 0:
            val1 = l1.val if l1 else 0
            val2 = l2.val if l2 else 0
            colSum = val1 + val2 + carry

            curr.next = ListNode(colSum % 10)
            curr = curr.next
            carry = colSum // 10

            l1 = l1.next if l1 else None
            l2 = l2.next if l2 else None
        return dummyHead.next
